// the conv module implements functions for converting
// types to and from strings, such as integer parsing and
// printing

alloc efx = mut mem;
loop efx = while;

fn digit_count(x u64, c u64) u64 = {
    if x == 0 {
        return c;
    } else if x < 10 {
        return c + 1;
    } else {
        return digit_count(x / 10, c + 1);
    };
};

// requires a to be the length of the number plus 16
pub fn from_u64(src u64, mut a mem) !str @ a = alloc & loop {
    // quick results
    switch src;
    | 0 do return "0";
    | 1 do return "1";
    | else {};
    // allocate string buffer
    let len = digit_count(src, 0);
    test len > 0;
    let mut buff = new ? [len u64; 0...] u8 @ a;
    // convert
    let mut acc = src;
    for mut digit .. buff {
        digit = (acc % 10 + '0') u8;
        acc = acc / 10;
    };
    let half = len / 2;
    let mut i = 0 u64;
    while i < half {
        let tmp = buff[i]!;
        buff[i]! = buff[len - i - 1]!;
        buff[len - i - 1]! = tmp;
        i = i + 1;
    };
    return buff[0..len]! str;
};

// requires a to be at least twice the length of the number
// plus 32
pub fn from_i64(src i64, mut a mem) !str @ a = alloc & loop {
    let mut neg = src < 0;
    let val = -src if neg else src;
    let val' = from_u64(val u64, a)?;
    if neg {
        return (cat "-" ..? val' @ a) str;
    } else {
        return val';
    };
};

// requires a to be at least twice the length of the number
// plus 32
pub fn from_f64(src f64, mut a mem) !str @ a = alloc & loop {
    // quick results
    switch src;
    | 0 do return "0";
    | 1 do return "1";
    | else {};

    let maxdec = 3 u64;
    let dgcont = digit_count(src u64, 0);
    let maxlen = (dgcont if dgcont > 0 else 1)  + 1 + (1 if src < 0 else 0) + maxdec;

    let mut buff = new ? [maxlen; 0...] u8 @ a;
    let mut len = 0 u64;
    new local | #a {
        let int = from_i64(src u64, local)?;
        for itm, idx .. int {
            buff[idx]! = itm;
            len = len + 1;
        };
        buff[len]! = '.';
        len = len + 1;
    }?;
    let mut dec = src if src > 0.0 else -src;

    let mut i = 0 u64;
    while i < maxdec && len < #buff {
        dec = dec * 10.0;
        let digit = (dec u64) % 10;
        buff[len]! = (digit u8 + '0');
        len = len + 1;
        i = i + 1;
    };
    return buff str;
};

pub fn to_u64(src str) !u64 = {
    // quick results
    switch src;
    | "0" do return 0;
    | "1" do return 1;
    | else {};
    // convert in base 10
    let mut dest = 0 u64;
    for digit .. src {
        // validate digit
        test ? digit >= '0' && digit <= '9';
        // move numbers foward
        dest = dest * 10;
        // sum the next digit
        dest = dest + (digit u64 - '0');
    };
    return dest;
};

pub fn from_cstr(src cstr, mut a mem) !str @ a = alloc {
    return error;
};
